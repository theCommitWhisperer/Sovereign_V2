{
  "name": "Sovereign_V2",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Shared": { "$path": "src/shared" },
      "Packages": { "$path": "Packages" },
      "UIAssets": { "$path": "src/shared/assets/ui" }
    },

    "ServerScriptService": {
      "Server": { "$path": "src/server" }
    },

    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": { "$path": "src/client" },
        "UI": { "$path": "src/ui" }
      }
    },

    "StarterGui": {},

    "Workspace": {
      "$properties": { "FilteringEnabled": true, "StreamingEnabled": false },
      "Lighting": {
        "$className": "Lighting",
        "$properties": {
          "Ambient": [ 0, 0, 0 ],
          "Brightness": 2,
          "GlobalShadows": true,
          "Outlines": false,
          "Technology": "Voxel"
        }
      }
    },

    "SoundService": {
      "$properties": { "RespectFilteringEnabled": true }
    }
  }
}
