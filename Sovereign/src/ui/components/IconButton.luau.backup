local React = require(game.ReplicatedStorage.Packages.react)
local UIConfig = require(script.Parent.Parent.UIConfig)

local IconButton = React.Component:extend("IconButton")

function IconButton:render()
	-- Use custom button background image if provided, otherwise use standard
	local buttonBackground = self.props.ButtonImage or "rbxassetid://105781657626004"

	return React.createElement("ImageButton", {
		Name = self.props.Name or "IconButton",
		Size = self.props.Size or UDim2.new(0, 50, 0, 50),
		Position = self.props.Position,
		AnchorPoint = self.props.AnchorPoint,
		LayoutOrder = self.props.LayoutOrder,
		Image = buttonBackground,
		ScaleType = self.props.ScaleType or Enum.ScaleType.Stretch,
		BackgroundTransparency = 1, -- Transparent since we're using the image
		BorderSizePixel = 0,
		ImageColor3 = self.props.ImageColor3 or Color3.fromRGB(255, 255, 255),
		ZIndex = self.props.ZIndex,
		Active = true, -- Ensure button captures input
		[React.Event.MouseButton1Click] = self.props.OnClick,
	}, {
		-- White glow overlay when selected (using a slightly larger copy of the image)
		GlowOverlay = self.props.ShowGlow
				and React.createElement("ImageLabel", {
					Size = UDim2.fromScale(1.5, 1.5),
					Position = UDim2.fromScale(0.5, 0.5),
					AnchorPoint = Vector2.new(0.5, 0.5),
					Image = buttonBackground,
					ImageColor3 = Color3.fromRGB(255, 255, 255),
					ImageTransparency = 0.3,
					BackgroundTransparency = 1,
					ScaleType = self.props.ScaleType or Enum.ScaleType.Stretch,
					ZIndex = 1, -- In front of button, behind icons
				})
			or nil,
		-- Icon/emoji overlay
		Icon = self.props.Icon and React.createElement("TextLabel", {
			Size = UDim2.new(1, 0, 1, 0),
			BackgroundTransparency = 1,
			Text = self.props.Icon,
			Font = Enum.Font.GothamBold,
			TextSize = self.props.IconSize or 20,
			TextColor3 = self.props.IconColor or UIConfig.HUD.PanelTextColor,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextYAlignment = Enum.TextYAlignment.Center,
		}) or nil,

		-- Optional image icon (for non-emoji icons)
		ImageIcon = self.props.ImageIcon and React.createElement("ImageLabel", {
			Size = self.props.ImageIconSize or UDim2.new(0.7, 0, 0.7, 0),
			Position = UDim2.fromScale(0.5, 0.5),
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundTransparency = 1,
			Image = self.props.ImageIcon,
			ScaleType = Enum.ScaleType.Fit,
		}) or nil,

		-- Optional text label below icon
		Label = self.props.Label and React.createElement("TextLabel", {
			Size = UDim2.new(1, 0, 0, 15),
			Position = UDim2.new(0, 0, 1, 2),
			BackgroundTransparency = 1,
			Text = self.props.Label,
			Font = Enum.Font.GothamBold,
			TextSize = self.props.LabelSize or 10,
			TextColor3 = self.props.LabelColor or UIConfig.HUD.PanelTextColor,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextYAlignment = Enum.TextYAlignment.Top,
		}) or nil,
	})
end

return IconButton
